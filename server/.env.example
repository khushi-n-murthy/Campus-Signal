# Copy this file to .env and fill it in.

# MongoDB: local install -> mongodb://127.0.0.1:27017   Atlas -> mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=campussignal

PORT=4000
# The address phones use to reach the site. Used inside the QR codes. No trailing slash.
PUBLIC_URL=http://localhost:4000

# Public IP(s) of your campus WiFi, from /api/whoami while on campus WiFi. Comma separated, e.g. 203.0.113.7/32
CAMPUS_CIDRS=

# Any long random string. Change it once and never again (changing it splits device counts).
DEVICE_SALT=change-me-to-a-long-random-string

# Local: loopback. Render/Railway: 1 (one proxy in front). See guide Phase 9.
TRUST_PROXY=loopback

WINDOW_DAYS=28
# Show seeded practice data? true while building, false once real data comes in.
INCLUDE_DEMO=true
RATE_LIMIT_SECONDS=120
